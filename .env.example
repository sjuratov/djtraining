# Required for auth
JWT_SECRET=change-me-to-a-random-string

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# App URL (for email verification links)
APP_URL=http://localhost:3001

# API URL (for OAuth redirect URI)
API_URL=http://localhost:5001

# Admin email — this user automatically gets admin role on registration
ADMIN_EMAIL=your-admin@example.com

# Database path (SQLite)
# Default: ./data/djtraining.db (relative to API working directory)
# Use :memory: for ephemeral in-memory database (tests only)
DATABASE_PATH=./data/djtraining.db

# Optional SMTP email configuration (when omitted, a local stub is used)
# EMAIL_DELIVERY_MODE=auto   # auto | smtp | stub
# In automated test-mode (`ENABLE_TEST_ROUTES=true` or `NODE_ENV=test`), `auto` suppresses real sends.
# EMAIL_LOG_VERIFICATION_URLS=false   # local-only manual diagnostics; ignored outside localhost runtimes
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# Test routes for local automation only
# ENABLE_TEST_ROUTES=true   # only honored in localhost development; ignored elsewhere
